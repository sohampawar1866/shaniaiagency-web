# ==============================================================================
# SHANIAI AGENCY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TURSO DATABASE CONFIGURATION
# Sign up at https://turso.tech/ to get your database URL and Auth token.
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://shanidw-db-shanidw.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS TOGGLE & RESEND CONFIGURATION
# Set ENABLE_EMAIL_NOTIFICATIONS to "true" when ready to enable emails (e.g. after domain purchase).
# Set to "false" to turn off all emails. All submissions are still saved to Turso DB.
# ------------------------------------------------------------------------------
ENABLE_EMAIL_NOTIFICATIONS=false

# Resend API Key for sending emails
RESEND_API_KEY=re_123456789_your_resend_api_key_here

# Verified Sender Email (e.g., ShaniAI Agency <soham@shaniaiagency.tech>)
RESEND_FROM_EMAIL=ShaniAI Agency <onboarding@resend.dev>

# Inbox email to receive real-time new lead alerts
RESEND_NOTIFICATION_EMAIL=soham@shaniaiagency.tech
